# Use credentials for this new product only. This example is for local development.
DATABASE_URL=postgresql://rekky_local:local_only_change_me@127.0.0.1:55432/rekky_local
PORT=3088
HOST=127.0.0.1
# Per-account rolling 24h cap at each voice stage; extraction + refinement share it.
# Range 1..100. Global cap stays 100; category-learning budgets stay separate.
PILOT_DAILY_ACCOUNT_LIMIT=12
# Per-account Ask runs in a rolling 24h window. Local testing can raise this to 100.
# The separate 500-run global daily cap still applies.
ASK_DAILY_ACCOUNT_LIMIT=30
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=
# Optional voice transcription provider. Keep this secret backend-only.
# The app discloses OpenAI processing and asks separately before each account's first upload.
OPENAI_API_KEY=
# These switches enable the local pilot; they do not certify an account-policy audit.
# Review the project data-sharing and retention settings before a broader pilot.
OPENAI_TRANSCRIPTION_ENABLED=false
OPENAI_EXTRACTION_ENABLED=false
# Background generic-category discovery; requires the account processing permission.
# Up to two calls for a new phrase, then reuse. Separate bounded pilot budget.
CATEGORY_LEARNING_ENABLED=false
# Do not copy the legacy environment wholesale or reuse its database URL.

# Optional public-venue address lookup. Backend only; never bundle this key in Flutter.
GOOGLE_MAPS_API_KEY=
GOOGLE_PLACES_ENABLED=false

# Owner-only intelligent Ask; gpt-6-luna, max 3 decisions / 4 read tools.
# Requires account processing permission; ASK_DAILY_ACCOUNT_LIMIT/account and 500/global per rolling 24h.
OPENAI_ASK_ENABLED=false
