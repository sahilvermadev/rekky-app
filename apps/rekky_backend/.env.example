# Use credentials for this new product only. This example is for local development.
DATABASE_URL=postgresql://rekky_local:local_only_change_me@127.0.0.1:55432/rekky_local
PORT=3088
HOST=127.0.0.1
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=
# Optional voice transcription provider. Keep this secret backend-only.
# The app discloses OpenAI processing and asks separately before each account's first upload.
OPENAI_API_KEY=
# These switches enable the local pilot; they do not certify an account-policy audit.
# Review the project data-sharing and retention settings before a broader pilot.
OPENAI_TRANSCRIPTION_ENABLED=false
OPENAI_EXTRACTION_ENABLED=false
# Do not copy the legacy environment wholesale or reuse its database URL.

# Optional public-venue address lookup. Backend only; never bundle this key in Flutter.
GOOGLE_MAPS_API_KEY=
GOOGLE_PLACES_ENABLED=false
